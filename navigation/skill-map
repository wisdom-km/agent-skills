#!/bin/sh
# Find a real Python 3 and run skill_map.py. This script does not start a service.
# A name on PATH is not enough: the Windows Store alias "python3" exits 9009 and
# is not an interpreter. The Python process replaces this shell, so its exit code
# is the exit code of this command.
set -eu

python_ok() {
  _out=$("$@" -c 'import sys; print(sys.version.split()[0])' 2>/dev/null) || return 1
  case "$_out" in
    3.*) return 0 ;;
  esac
  return 1
}

# Do not call dirname or other PATH tools. A missing runtime is an empty PATH,
# and a Windows Store alias can sit on PATH without /usr/bin.
case $0 in
  */*) SCRIPT_DIR=${0%/*} ;;
  *) SCRIPT_DIR=. ;;
esac
SCRIPT_DIR=$(CDPATH= cd -- "$SCRIPT_DIR" && pwd)
SCRIPT="$SCRIPT_DIR/skill_map.py"

if python_ok py -3; then
  exec py -3 "$SCRIPT" "$@"
fi
if python_ok python3; then
  exec python3 "$SCRIPT" "$@"
fi
if python_ok python; then
  exec python "$SCRIPT" "$@"
fi

echo "skill-map: no working Python 3 interpreter was found. On Windows, python3 is often a Store alias that exits 9009 and is not Python. Tried: py -3, python3, python. Nothing was written." >&2
exit 127
