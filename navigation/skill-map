#!/bin/sh
# Run the skill-map command with python3. This script does not start a service.
set -eu
if ! command -v python3 >/dev/null 2>&1; then
  echo "skill-map: python3 was not found. This command did not change any project or skill source." >&2
  exit 127
fi
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
exec python3 "$SCRIPT_DIR/skill_map.py" "$@"
