# 复制成 .env 再填真实值。.env 不要提交；这份 .env.example 要提交。
# 只写变量名和假值。每个变量写一行用途说明。

# 运行环境：dev 或 prod
APP_ENV=dev

# 日志级别：ERROR / WARN / INFO / DEBUG（排查问题时临时改成 DEBUG）
LOG_LEVEL=INFO

# 数据库连接（开发库）。正式库的连接不要放进 agent 能读到的文件
DATABASE_URL=postgres://<user>:<password>@localhost:5432/app_dev

# 第三方服务的密钥（例子）。真实值只放在 .env 或部署平台的密钥设置里
EXAMPLE_API_KEY=replace-me
